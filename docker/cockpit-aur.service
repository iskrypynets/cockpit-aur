[Unit]
Description=Cockpit AUR (Podman Container)
After=network.target

[Service]
Type=exec
Restart=always
RestartSec=3s
TimeoutStopSec=10s
ExecStartPre=-/usr/bin/podman rm -f cockpit-aur
ExecStart=/usr/bin/podman run --name cockpit-aur \
    --rm \
    --stop-timeout 5 \
    -p 9090:9090 \
    -v /var/lib/pacman/local:/var/lib/pacman/local:ro \
    -v /tmp/checkup-db-1000:/tmp/checkup-db-1000:ro \
    -v /var/lib/pacman/sync:/host/var/lib/pacman/sync:ro \
    -v /etc/pacman.conf:/etc/pacman.conf:ro \
    -v /etc/pacman.d:/etc/pacman.d:ro \
    -v /var/cache/pacman/pkg:/var/cache/pacman/pkg:ro \
    -v /run/dbus/system_bus_socket:/run/dbus/system_bus_socket \
    -v /run/user/1000/bus:/run/user/1000/bus \
    -e DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
    localhost/cockpit-aur:local
ExecStop=/usr/bin/podman stop -t 5 cockpit-aur

[Install]
WantedBy=default.target
